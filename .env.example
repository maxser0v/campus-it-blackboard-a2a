# Copy to .env for a local run. These are placeholders, not valid production secrets.
CAMPUS_ENV=local
CAMPUS_DATABASE_PATH=.data/blackboard.sqlite3
CAMPUS_BIND_HOST=127.0.0.1
CAMPUS_BLACKBOARD_URL=http://127.0.0.1:8100
CAMPUS_CONTROLLER_URL=http://127.0.0.1:8101
CAMPUS_BLACKBOARD_PORT=8100
CAMPUS_CONTROLLER_PORT=8101
CAMPUS_EVIDENCE_URL=http://127.0.0.1:8102
CAMPUS_DIAGNOSIS_URL=http://127.0.0.1:8103
CAMPUS_REVIEW_URL=http://127.0.0.1:8104
CAMPUS_RESPONSE_URL=http://127.0.0.1:8105

# Map each authenticated local A2A credential to its canonical actor.
# Replace each placeholder with a random local value before starting services.
CAMPUS_AGENT_CREDENTIALS_JSON={"controller":"replace-controller-token","evidence":"replace-evidence-token","diagnosis":"replace-diagnosis-token","review":"replace-review-token","response":"replace-response-token","dashboard":"replace-dashboard-readonly-token"}

# Keep model access configurable; offline mode does not make a provider call.
CAMPUS_MODEL_MODE=offline
# groq (existing compatible HTTP settings), openai_compatible, or codex_cli
CAMPUS_MODEL_PROVIDER=groq
# Codex uses its own model selection and existing ChatGPT login, not the Groq key.
CAMPUS_CODEX_EXECUTABLE=codex
CAMPUS_CODEX_MODEL=
CAMPUS_CODEX_REASONING_EFFORT=
CAMPUS_CODEX_TIMEOUT_SECONDS=180
CAMPUS_MODEL_BASE_URL=
CAMPUS_MODEL_NAME=
CAMPUS_MODEL_API_KEY=
CAMPUS_MODEL_TIMEOUT_SECONDS=60
CAMPUS_MODEL_MAX_OUTPUT_TOKENS=1600
CAMPUS_MODEL_TOKEN_LIMIT_PARAMETER=max_tokens
CAMPUS_MAX_RUN_TOKENS=12000

